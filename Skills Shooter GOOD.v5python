{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\nclass Robot():\n    def __init__(self):\n        \n        self.controller_to_rpm_calc = 200\n\n        self.up_or_down_dir = FORWARD\n        self.moving = True\n        self.intake_moving = True\n        \n        self.shooter_thread_started = False\n        self.shooter_thread = 0\n        self.shooter_thread_act_started = False\n        self.shooter_thread_act = 0\n\n        self.is_intake_pressed = False\n        self.is_conveyor_pressed = True\n\n        right_drive_motor_val = Ports.PORT20\n        left_drive_motor_val = Ports.PORT19\n        top_shooter_motor_val = Ports.PORT1\n        bottom_shooter_motor_val = Ports.PORT2\n        intake_motor_val = Ports.PORT18\n\n        conveyor_motor_val = brain.three_wire_port.a\n        height_motor_val = brain.three_wire_port.b\n\n        self.right_drive_motor = Motor(right_drive_motor_val, GearSetting.RATIO_18_1, False)\n        self.left_drive_motor = Motor(left_drive_motor_val, GearSetting.RATIO_18_1, False)\n        self.top_shooter_motor = Motor(top_shooter_motor_val, GearSetting.RATIO_18_1, False)\n        self.bottom_shooter_motor = Motor(bottom_shooter_motor_val, GearSetting.RATIO_18_1, False)\n        self.intake_motor = Motor(intake_motor_val, GearSetting.RATIO_18_1, False)\n\n        self.conveyor_motor = Motor29(conveyor_motor_val)\n        self.height_motor = Motor29(height_motor_val)\n\n        self.drive_train = DriveTrain(self.left_drive_motor, self.right_drive_motor, 104.02*math.pi, 381 - 26.3, 247.65, MM, 1)\n\n        self.controller = Controller()\n\n        self.up_and_down_encoder = Encoder(brain.three_wire_port.g)\n        self.up_and_down_encoder.set_position(0)\n\n        self.is_another_intake_running = False\n        self.is_another_conveyor_running = False\n\n    def custom_drive(self):\n        #axis 1 is right axis, left and right\n        #axis 2 is right axis, up and down\n        #axis 3 is left axis, left and right\n        #axis 4 is left axis, up and down\n        #controller is up to 100\n        axis_one = self.controller.axis1.position()/100\n        axis_two = self.controller.axis2.position()/100\n        axis_three = self.controller.axis3.position()/100\n        axis_four = self.controller.axis4.position()/100\n\n\n        #Any axes that is close to 1, -1, or 0 will be rounded.\n        axes_list = [axis_one, axis_two, axis_four, axis_three]\n        print(axes_list)\n        for j in range(len(axes_list)):\n            i = axes_list[j]\n            if i > 0.8 or i < -0.8 or (i< 0.2 and i > -0.2):\n                axes_list[j] = round(axes_list[j])\n\n        #If controller is in Q1\n        if axes_list[2] > 0 and axes_list[3] > 0:\n            self.left_drive_motor.set_reversed(False)\n            self.left_drive_motor.set_velocity((axes_list[2]**2 + axes_list[3]**2)**(1/2) * self.controller_to_rpm_calc)\n            self.right_drive_motor.set_reversed(False)\n            self.right_drive_motor.set_velocity(axes_list[2])\n        #Q3\n        elif axes_list[2] < 0 and axes_list[3] < 0:\n            self.left_drive_motor.set_reversed(True)\n            self.left_drive_motor.set_velocity((axes_list[2]**2 + axes_list[3]**2)**(1/2) * self.controller_to_rpm_calc)\n            self.right_drive_motor.set_reversed(True)\n            self.right_drive_motor.set_velocity(axes_list[2])\n        #Q2\n        elif axes_list[2] < 0 and axes_list[3] > 0:\n            self.left_drive_motor.set_reversed(True)\n            self.left_drive_motor.set_velocity(axes_list[2])\n            self.right_drive_motor.set_reversed(True)\n            self.right_drive_motor.set_velocity((axes_list[2]**2 + axes_list[3]**2)**(1/2) * self.controller_to_rpm_calc)\n        #Q4\n        elif axes_list[2] > 0 and axes_list[3] < 0:\n            self.left_drive_motor.set_reversed(False)\n            self.left_drive_motor.set_velocity(axis_three)\n            self.right_drive_motor.set_reversed(False)\n            self.right_drive_motor.set_velocity((axes_list[2]**2 + axes_list[3]**2)**(1/2) * self.controller_to_rpm_calc)\n\n        # On y-axis\n        elif axes_list[3] == 0:\n            self.left_drive_motor.set_reversed(False)\n            self.left_drive_motor.set_velocity(axes_list[2]*self.controller_to_rpm_calc)\n            self.right_drive_motor.set_reversed(False)\n            self.right_drive_motor.set_velocity(axes_list[2]*self.controller_to_rpm_calc)\n        # On x-axis\n        elif axes_list[2] == 0:\n            self.left_drive_motor.set_reversed(False)\n            self.left_drive_motor.set_velocity(axes_list[3]*self.controller_to_rpm_calc)\n            self.right_drive_motor.set_reversed(True)\n            self.right_drive_motor.set_velocity(axes_list[3]*self.controller_to_rpm_calc)\n        # If not moving\n        elif axis_three == 0 and axes_list[3] == 0:\n            self.left_drive_motor.set_reversed(False)\n            self.left_drive_motor.set_velocity(0)\n            self.right_drive_motor.set_reversed(False)\n            self.right_drive_motor.set_velocity(0)\n\n        self.right_drive_motor.spin(FORWARD)\n        self.left_drive_motor.spin(FORWARD)\n\n    def custom_shooter(self):\n        # self.top_shooter_motor.set_velocity(100, PERCENT)\n        # self.bottom_shooter_motor.set_velocity(100, PERCENT)\n        # self.top_shooter_motor.spin(REVERSE)\n        # self.bottom_shooter_motor.spin(FORWARD)\n\n        if self.shooter_thread_act_started == False:\n            self.shooter_thread_act = Thread(self.move_shooter_back_thread)\n            self.shooter_thread_act_started = True\n        \n        if self.shooter_thread_started == False:\n            self.shooter_thread = Thread(self.move_conveyor_back_thread)\n            self.shooter_thread_started = True\n\n    def is_intake_pressed_command(self):\n        self.is_intake_pressed = True\n\n    def is_conveyor_pressed_command(self):\n        self.is_conveyor_pressed = True\n\n    def intake_and_conveyor_pressed_command(self):\n        self.is_intake_pressed = True\n        self.is_conveyor_pressed = True\n    \n    def intake_and_conveyor(self):\n        self.custom_intake()\n        self.custom_conveyor()\n\n    def intake_and_conveyor_back(self):\n        self.custom_intake_back()\n        self.custom_conveyor_back()\n\n    def custom_shooter_stop(self):\n        if self.shooter_thread_act != 0:\n            self.shooter_thread_act.stop()\n            self.shooter_thread_act = 0\n            self.top_shooter_motor.stop()\n            self.bottom_shooter_motor.stop()\n        self.shooter_thread_act_started = False\n\n        if self.shooter_thread != 0:\n            self.shooter_thread.stop()\n            self.shooter_thread = 0\n            self.conveyor_motor.stop()\n        self.shooter_thread_started = False\n\n    def custom_intake(self):\n        print(\"AAAAA\")\n        #self.intake_motor.set_reversed(False)\n        if self.is_intake_pressed == True:\n            self.intake_motor.set_velocity(100, PERCENT)\n            if self.intake_moving == False:\n                self.is_another_intake_running = False\n                self.intake_motor.stop()\n                self.intake_moving = True\n            else:\n                self.is_another_intake_running = True\n                self.intake_motor.spin(REVERSE)\n                self.intake_moving = False\n        self.is_intake_pressed = False\n\n    def custom_conveyor(self):\n        #self.conveyor_motor.set_reversed(False)\n        if self.is_conveyor_pressed:\n            self.conveyor_motor.set_velocity(100, PERCENT)\n            if self.moving == False:\n                self.conveyor_motor.stop()\n                self.is_another_conveyor_running = False\n                self.moving = True\n            else:\n                self.is_another_conveyor_running = True\n                self.conveyor_motor.spin(REVERSE)\n                self.moving = False\n        self.is_conveyor_pressed = False\n\n    def custom_intake_back(self):\n        print(\"AAAAA\")\n        #self.intake_motor.set_reversed(True)\n        if self.is_intake_pressed == True:\n            self.intake_motor.set_velocity(100, PERCENT)\n            if self.intake_moving == False:\n                self.is_another_intake_running = False\n                self.intake_motor.stop()\n                self.intake_moving = True\n            else:\n                self.is_another_intake_running = True\n                self.intake_motor.spin(FORWARD)\n                self.intake_moving = False\n        self.is_intake_pressed = False\n\n    def custom_conveyor_back(self):\n        #self.conveyor_motor.set_reversed(True)\n        if self.is_conveyor_pressed:\n            self.conveyor_motor.set_velocity(100, PERCENT)\n            if self.moving == False:\n                self.is_another_intake_running = False\n                self.conveyor_motor.stop()\n                self.moving = True\n            else:\n                self.is_another_intake_running = True\n                self.conveyor_motor.spin(FORWARD)\n                self.moving = False\n        self.is_conveyor_pressed = False\n\n    def custom_height_up(self):\n\n        #brain.screen.print(self.up_and_down_encoder.position(DEGREES), sep = \"aaa\")\n        self.height_motor.set_velocity(50, PERCENT)\n        self.height_motor.spin(FORWARD)\n        # if self.up_and_down_encoder.position(DEGREES) <= -10:\n        #     self.custom_height_stop()\n\n    def custom_height_down(self):\n        #brain.screen.print(self.up_and_down_encoder.position(DEGREES), sep = \"aaa\")\n        self.height_motor.set_velocity(50, PERCENT)\n        self.height_motor.spin(REVERSE)\n        # if self.up_and_down_encoder.position(DEGREES) >= 0:\n        #     self.custom_height_stop()\n\n    def help_me_from_chaves(self):\n        self.top_shooter_motor.set_velocity(20, PERCENT)\n        self.bottom_shooter_motor.set_velocity(20, PERCENT)\n        self.top_shooter_motor.spin(FORWARD)\n        self.bottom_shooter_motor.spin(REVERSE)\n\n        \n    def custom_height_stop(self):\n        self.height_motor.stop()\n\n    def move_conveyor_back_thread(self):\n        #self.conveyor_motor.set_reversed(False)\n        self.conveyor_motor.stop()\n        self.conveyor_motor.spin(FORWARD)\n        wait(1, SECONDS)\n        self.conveyor_motor.stop()\n        wait(2, SECONDS)\n        while True:\n            self.conveyor_motor.spin(REVERSE)\n    \n    def move_shooter_back_thread(self):\n        self.top_shooter_motor.set_velocity(20, PERCENT)\n        self.bottom_shooter_motor.set_velocity(20, PERCENT)\n        self.top_shooter_motor.spin(FORWARD)\n        self.bottom_shooter_motor.spin(REVERSE)\n        wait(0, SECONDS)\n        self.top_shooter_motor.set_velocity(100, PERCENT)\n        self.bottom_shooter_motor.set_velocity(100, PERCENT)\n        while True:\n            self.top_shooter_motor.spin(REVERSE)\n            self.bottom_shooter_motor.spin(FORWARD)\n\n\n    def contain(self):\n        #self.conveyor_motor.set_reversed(False)\n        #self.intake_motor.set_reversed(True)\n        self.top_shooter_motor.set_velocity(10, PERCENT)\n        self.bottom_shooter_motor.set_velocity(10, PERCENT)\n        self.conveyor_motor.spin(FORWARD)\n        self.top_shooter_motor.spin(FORWARD)\n        self.bottom_shooter_motor.spin(REVERSE)\n        self.intake_motor.spin(REVERSE)\n\n    def stop_contain(self):\n        self.conveyor_motor.stop()\n        self.intake_motor.stop()\n\n    def stop_contain_shooter(self):\n        self.top_shooter_motor.stop()\n        self.bottom_shooter_motor.stop()\n\n\n\n        \n\n#when_started1()\n\nrobot = Robot()\nrobot.controller.buttonL1.pressed(robot.intake_and_conveyor_pressed_command)\n#robot.controller.buttonL1.pressed(robot.is_conveyor_pressed_command)\nrobot.controller.buttonL1.released(robot.intake_and_conveyor_back)\n#robot.controller.buttonL1.released(robot.custom_conveyor_back)\n\nrobot.controller.buttonL2.pressed(robot.intake_and_conveyor_pressed_command)\n#robot.controller.buttonL2.pressed(robot.is_conveyor_pressed_command)\nrobot.controller.buttonL2.released(robot.intake_and_conveyor)\n#robot.controller.buttonL2.released(robot.custom_conveyor)\n\n#robot.controller.buttonR1.pressed(robot.contain)\n#robot.controller.buttonR1.released(robot.stop_contain)\n\n#prep shoot\nrobot.controller.buttonA.pressed(robot.custom_height_up)\nrobot.controller.buttonA.released(robot.custom_height_stop)\n\nrobot.controller.buttonB.pressed(robot.custom_height_down)\nrobot.controller.buttonB.released(robot.custom_height_stop)\n\nwhile True:\n    robot.custom_drive()\n    if robot.controller.buttonR2.pressing():\n        robot.custom_shooter()\n    else:\n        robot.custom_shooter_stop()\n\n    if robot.controller.buttonR1.pressing() and robot.is_another_conveyor_running == False and robot.is_another_intake_running == False and robot.controller.buttonR2.pressing() == False:\n        robot.contain()\n    else:\n        #robot.stop_contain()\n        if robot.is_another_conveyor_running == False and robot.is_another_intake_running == False and robot.controller.buttonR2.pressing() == False:\n            robot.stop_contain()\n\n        if robot.controller.buttonR2.pressing() == False:\n            robot.stop_contain_shooter()","textLanguage":"python","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.0.7","minVersion":"3.1.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"target":"Physical"}