{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\nclass Robot():\n    def __init__(self):\n\n        self.controller_to_rpm_calc = 200\n\n        # Used for Toggle\n        self.intake_running = False\n        self.intake_running_backwards = False\n        self.intake_pressed = False\n\n        # Used for trigger\n        self.intake_forward_pressed = False\n        self.intake_backward_pressed = False\n\n        self.intake_not_activated = True\n\n        self.brain = Brain()\n\n        right_drive_motor_val = Ports.PORT2\n        left_drive_motor_val = Ports.PORT1\n        side_drive_motor_val = Ports.PORT3\n        lever_motor = Ports.PORT5\n\n        right_intake_motor = brain.three_wire_port.a\n        left_intake_motor = brain.three_wire_port.b\n        top_intake_motor = brain.three_wire_port.e\n        top_intake_servo = brain.three_wire_port.c\n        tray_release_servo = brain.three_wire_port.f\n\n\n\n        self.right_drive_motor = Motor(right_drive_motor_val, GearSetting.RATIO_18_1, False)\n        self.left_drive_motor = Motor(left_drive_motor_val, GearSetting.RATIO_18_1, False)\n        self.side_drive_motor = Motor(side_drive_motor_val, GearSetting.RATIO_18_1, False)\n        self.lever_motor = Motor(lever_motor, GearSetting.RATIO_18_1, False)\n\n        self.right_intake_motor = Motor29(right_intake_motor)\n        self.left_intake_motor = Motor29(left_intake_motor)\n        self.tray_release_servo = Servo(tray_release_servo)\n        self.top_intake_motor = Motor29(top_intake_motor)\n        self.top_intake_servo = Servo(top_intake_servo)\n\n\n        self.drive_train = DriveTrain(self.left_drive_motor, self.right_drive_motor, 104.02*math.pi, 381 - 26.3, 247.65, MM, 1)\n\n        self.controller = Controller()\n        \n        self.tray_release_servo.set_position(90, DEGREES)\n        self.top_intake_servo.set_position(-45, DEGREES)\n\n        self.lever_motor.set_velocity(25, PERCENT)\n\n    def motor_move(self, l_reversed, r_reversed, s_reversed, l_speed, r_speed, s_speed):\n        self.left_drive_motor.set_reversed(l_reversed)\n        self.left_drive_motor.set_velocity(l_speed*self.controller_to_rpm_calc)\n        self.right_drive_motor.set_reversed(r_reversed != True)\n        self.right_drive_motor.set_velocity(r_speed*self.controller_to_rpm_calc)\n        self.side_drive_motor.set_reversed(s_reversed != True)\n        self.side_drive_motor.set_velocity(s_speed*self.controller_to_rpm_calc)\n\n    def custom_drive(self):\n        #axis 1 is right axis, left and right\n        #axis 2 is right axis, up and down\\\n        #axis 3 is left axis, left and right\n        #axis 4 is left axis, up and down\n        #THIS IS UPDATED\n        #controller is up to 100\n        axis_one = self.controller.axis1.position()/100\n        axis_two = self.controller.axis2.position()/100\n        axis_three = self.controller.axis3.position()/100\n        axis_four = self.controller.axis4.position()/100\n\n        axes_list = [axis_one, axis_two, axis_three, axis_four]\n        #self.brain.screen.clear_screen()\n        for j in range(len(axes_list)):\n            i = axes_list[j]\n            if i > 0.9 or i < -0.9 or (i< 0.1 and i > -0.1):\n                axes_list[j] = round(axes_list[j])\n\n        if axes_list[2] < 0 and axes_list[3] > 0:\n            self.motor_move(False, False, False, axes_list[2], axes_list[2], axes_list[3])\n        elif axes_list[2] < 0 and axes_list[3] < 0:\n            self.motor_move(False, False, False, axes_list[2], axes_list[2], axes_list[3])\n        elif axes_list[2] > 0 and axes_list[3] > 0:\n            self.motor_move(False, False, False, axes_list[2], axes_list[2], axes_list[3])\n        elif axes_list[2] > 0 and axes_list[3] < 0:\n            self.motor_move(False, False, False, axes_list[2], axes_list[2], axes_list[3])\n\n        elif axes_list[2] == 0 and axes_list[3] == 0:\n            if axes_list[0] != 0 and axes_list[1] != 0:\n                val = False\n                if axes_list[1] >= 0:\n                    val = True\n                if axes_list[0] >= 0:\n                    self.motor_move(True,True,False, -(abs(axes_list[0])+abs(axes_list[1]))**2, (abs(axes_list[0])+abs(axes_list[1]))**2, 0)\n                else:\n                    self.motor_move(True,True,False, (abs(axes_list[0])+abs(axes_list[1]))**2, -(abs(axes_list[0])+abs(axes_list[1]))**2, 0)\n            else:\n                # if axes_list[0] < 0:\n                #     self.motor_move(True, True, False, (abs(axes_list[0])+abs(axes_list[1]))**2, -(abs(axes_list[0])+abs(axes_list[1]))**2, 0)\n                # else:\n                self.motor_move(False, False, False, 0, 0, 0)\n        \n        elif axes_list[3] == 0:\n            self.motor_move(False, False, False, axes_list[2], axes_list[2], 0)\n        elif axes_list[2] == 0:\n            self.motor_move(False, False, False, 0, 0, axes_list[3])\n\n        #self.custom_rotate_one(axes_list)\n\n        self.right_drive_motor.spin(FORWARD)\n        self.left_drive_motor.spin(FORWARD)\n        self.side_drive_motor.spin(FORWARD)\n\n    def custom_rotate_one(self, axes_list):\n        self.motor_move(True,False,False, axes_list[1], axes_list[2], 0)\n\n    def move_lever_up(self):\n        self.lever_motor.spin(REVERSE)\n\n    def move_lever_down(self):\n        self.lever_motor.spin(FORWARD)\n\n    def stop_lever(self):\n        self.lever_motor.stop()\n\n    def forward_intake_toggle(self):\n        if self.intake_pressed and not self.intake_running:\n            self.left_intake_motor.spin(REVERSE)\n            self.right_intake_motor.spin(REVERSE)\n            self.top_intake_motor.spin(FORWARD)\n            self.intake_pressed = False\n            self.intake_running = True\n            self.intake_running_backwards = False\n        else:\n            self.intake_pressed = False\n            self.intake_running = False\n            self.intake_running_backwards = False\n            self.stop_intake()\n\n    def backwards_intake_toggle(self):\n        if self.intake_pressed and not self.intake_running_backwards:\n            self.left_intake_motor.spin(FORWARD)\n            self.right_intake_motor.spin(FORWARD)\n            self.top_intake_motor.spin(REVERSE)\n            self.intake_pressed = False\n            self.intake_running = False\n            self.intake_running_backwards = True\n        else:\n            self.intake_pressed = False\n            self.intake_running = False\n            self.intake_running_backwards = False\n            self.stop_intake()\n\n    def forward_intake(self):\n        self.intake_forward_pressed = True\n        self.right_intake_motor.spin(FORWARD)\n        self.left_intake_motor.spin(FORWARD)\n        self.top_intake_motor.spin(REVERSE)\n\n\n    def backwards_intake(self):\n        self.intake_backward_pressed = True\n        self.right_intake_motor.spin(REVERSE)\n        self.left_intake_motor.spin(REVERSE)\n        self.top_intake_motor.spin(FORWARD)\n\n    def stop_intake(self):\n        self.left_intake_motor.stop()\n        self.right_intake_motor.stop()\n        self.top_intake_motor.stop()\n\n    def release_tray(self):\n        self.tray_release_servo.set_position(-270, DEGREES)\n    \n    def intake_motor(self):\n        if self.intake_not_activated:\n            self.top_intake_servo.set_position(25, DEGREES)\n            self.intake_not_activated = False\n        else:\n            self.top_intake_servo.set_position(-55, DEGREES)\n            self.intake_not_activated = True\n    \n    def set_intake_pressed(self):\n        self.intake_pressed = True\n\n    def set_intake_pressed_b(self):\n        self.intake_pressed = True\n\n    def set_intake_forward_false(self):\n        self.intake_forward_pressed = False\n\n    def set_intake_backward_false(self):\n        self.intake_backward_pressed = False\n\n\n\n    # def custom_rotate_two(self, axes_list):\n    #     if axes_list[2] > 0 and axes_list[3] > 0:\n    #         self.motor_move(False, True, False, (axes_list[2]**2 + axes_list[3]**2)**(1/2), (axes_list[2]**2 + axes_list[3]**2)**(1/2), 0)\n    #     elif axes_list[2] < 0 and axes_list[3] < 0:\n    #         self.motor_move(False, True, False, (axes_list[2]**2 + axes_list[3]**2)**(1/2), (axes_list[2]**2 + axes_list[3]**2)**(1/2), 0)\n    #     elif axes_list[2] < 0 and axes_list[3] > 0:\n    #         self.motor_move(True, True, True, axes_list[2], axes_list[2], axes_list[3])\n    #     elif axes_list[2] > 0 and axes_list[3] < 0:\n    #         self.motor_move(False, False, False, axes_list[2], axes_list[2], axes_list[3])\n\n    #     elif axes_list[3] == 0:\n    #         self.motor_move(False, False, False, axes_list[2], axes_list[2], 0)\n    #     elif axes_list[2] == 0:\n    #         self.motor_move(False, False, False, 0, 0, axes_list[3])\n    #     elif axis_three == 0 and axes_list[3] == 0:\n    #         self.motor_move(False, False, False, 0, 0, 0)\n    # def custom_rotate_three(self, axes_list):\n    #     self.motor_move(False,True,False, axes_list[3], axes_list[3], 0)\n\n    \n\n        \n\n#when_started1()\n\nrobot = Robot()\n# Toggle\n# robot.controller.buttonR2.pressed(robot.set_intake_pressed)\n# robot.controller.buttonR1.pressed(robot.set_intake_pressed_b)\n# robot.controller.buttonR2.released(robot.forward_intake)\n# robot.controller.buttonR1.released(robot.backwards_intake)\n\n# Trigger\n#robot.controller.buttonR2.pressed(robot.forward_intake)\n#robot.controller.buttonR1.pressed(robot.backwards_intake)\n#robot.controller.buttonR2.released(robot.set_intake_forward_false)\n#robot.controller.buttonR1.released(robot.set_intake_backward_false)\n\nrobot.controller.buttonL1.pressed(robot.move_lever_up)\nrobot.controller.buttonL2.pressed(robot.move_lever_down)\nrobot.controller.buttonL1.released(robot.stop_lever)\nrobot.controller.buttonL2.released(robot.stop_lever)\n\nrobot.controller.buttonDown.pressed(robot.release_tray)\nrobot.controller.buttonUp.pressed(robot.intake_motor)\n\n#robot.controller.buttonA.pressed(robot.custom_height_start)\n#robot.controller.buttonA.released(robot.custom_height_stop)\n\nwhile True:\n    robot.custom_drive()\n    if robot.controller.buttonR2.pressing() == True:\n        robot.forward_intake()\n    elif robot.controller.buttonR1.pressing() == True:\n        robot.backwards_intake()\n    else:\n        robot.stop_intake()\n    #     robot.custom_shooter()\n    # else:\n    #     robot.custom_shooter_stop()\n    # if robot.controller.buttonA.pressing():\n    #     robot.custom_height_start()\n    # else:\n    #     robot.custom_height_stop()","textLanguage":"python","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.0.7","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false}